YDLIDAR SDK: CMake 3.20+ / CMake 4 compatibility.
Complete replacement for patches/ydlidar_sdk.patch, not an incremental patch.
Apply to clean SDK sources using patch -p0 from the SDK parent directory.
Hunks deliberately omit unrelated whitespace-only context.

diff --git ydlidar-sdk/CMakeLists.txt ydlidar-sdk/CMakeLists.txt
--- ydlidar-sdk/CMakeLists.txt
+++ ydlidar-sdk/CMakeLists.txt
@@ -1,1 +1,1 @@
-cmake_minimum_required(VERSION 2.8)
+cmake_minimum_required(VERSION 3.20)
@@ -43,1 +43,1 @@
-set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
+set(CMAKE_EXPORT_COMPILE_COMMANDS OFF)
@@ -49,14 +48,0 @@
-# Policy CMP0023 allows to mix old and new interfaces of target_link_libraries
-if(COMMAND cmake_policy)
-	cmake_policy(SET CMP0003 NEW) # We don't want to mix relative and absolute paths in linker lib lists.
-	cmake_policy(SET CMP0005 NEW) # Escape definitions (-D) strings
-	if(POLICY CMP0053)
-		cmake_policy(SET CMP0053 OLD) # Simplify variable reference and escape sequence evaluation.
-	endif()
-	if(POLICY CMP0037)
-		cmake_policy(SET CMP0037 OLD)  # Allow defining target "test"
-	endif()
-	if(POLICY CMP0043)
-		cmake_policy(SET CMP0043 OLD) #  Ignore COMPILE_DEFINITIONS_<Config> properties.
-	endif()
-endif()
@@ -66,1 +52,1 @@
-option( BUILD_EXAMPLES "Build Example." ON)
+option( BUILD_EXAMPLES "Build Example." OFF)
@@ -72,1 +58,1 @@
-find_package(SWIG)
+# find_package(SWIG)
@@ -73,1 +59,1 @@
-find_package(PythonInterp)
+# find_package(PythonInterp)
@@ -74,1 +60,1 @@
-find_package(PythonLibs)
+# find_package(PythonLibs)
@@ -75,1 +61,1 @@
-find_package(GTest)
+# find_package(GTest)
@@ -114,1 +100,8 @@
-target_include_directories(${PROJECT_NAME} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/src)
+target_include_directories(${PROJECT_NAME} PUBLIC
+    "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>"
+    "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src>"
+    "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/core>"
+    "$<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}>"
+    "$<INSTALL_INTERFACE:include>"
